# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env はコミットしないこと（.gitignore済み）。
#
# 可能な限り、パスワード等の機微情報はここに平文で置かず、
# OS資格情報ストア/シークレットマネージャからの注入を検討すること
# （要確認: 社内PCのOS種別に応じた具体的な方式）。

# --- Google API ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
SPREADSHEET_ID=REPLACE_ME

# --- NAS / SMB ---
SMB_HOST=REPLACE_ME
SMB_SHARE=REPLACE_ME
SMB_USERNAME=REPLACE_ME
SMB_PASSWORD=REPLACE_ME
# 部屋の写真（kitchen.jpg等）は {NAS_SOURCE_ROOT}/{建物名}/{部屋番号}/ 直下にある。
# 完成品マイソクは {NAS_OUTPUT_ROOT}/{建物名}/{部屋番号}/マイソク/{日付}_{ファイル名}.jpg
# に書き込む。実際にはどちらも同じ共有内フォルダ（営業画像）を指す。
# 例: \\10.203.100.195\share\営業画像 なら SMB_HOST=10.203.100.195 / SMB_SHARE=share /
# NAS_SOURCE_ROOT=営業画像 / NAS_OUTPUT_ROOT=営業画像 とする。
NAS_SOURCE_ROOT=営業画像
NAS_OUTPUT_ROOT=営業画像

# --- Drive（完成品のうち一般・自社保証会社マイソクのみ保存する先） ---
# Drive APIは使わず、社内PCでGoogle Drive for Desktop等により同期されている
# ローカルフォルダへ直接書き込む。例: G:\マイドライブ\31書類\営業\最新空室情報\共有フォルダ
FINISHED_DRIVE_DIR=G:\マイドライブ\31書類\営業\最新空室情報\共有フォルダ

# --- ジョブ処理 (要確認: 実運用値。以下はデフォルトの仮値) ---
POLL_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=3
STALE_PROCESSING_MINUTES=10

# --- ログ ---
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
