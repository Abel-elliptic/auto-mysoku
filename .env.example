# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env はコミットしないこと（.gitignore済み）。
#
# 可能な限り、パスワード等の機微情報はここに平文で置かず、
# OS資格情報ストア/シークレットマネージャからの注入を検討すること
# （要確認: 社内PCのOS種別に応じた具体的な方式）。

# --- Google API ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
SPREADSHEET_ID=REPLACE_ME

# --- NAS / SMB ---
SMB_HOST=REPLACE_ME
SMB_SHARE=REPLACE_ME
SMB_USERNAME=REPLACE_ME
SMB_PASSWORD=REPLACE_ME
NAS_SOURCE_ROOT=募集用
# 完成品マイソクの出力先ルート（共有内相対パス）。この下に
# {建物名}/{部屋番号}/マイソク/{日付}_{ファイル名}.jpg で書き込む。
# 共有直下でよい場合は空のままでよい。
NAS_OUTPUT_ROOT=

# --- Drive（完成品のうち一般・自社保証会社マイソクのみアップロードする先） ---
FINISHED_DRIVE_FOLDER_ID=REPLACE_ME

# --- ジョブ処理 (要確認: 実運用値。以下はデフォルトの仮値) ---
POLL_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=3
STALE_PROCESSING_MINUTES=10

# --- ログ ---
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
